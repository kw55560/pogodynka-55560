{% extends 'base.html.twig' %}

{% block title %}Lista prognoz pogody{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Prognozy pogody (Pomiary)</h1>
        <a href="{{ path('app_measurement_new') }}" class="btn btn-primary">Dodaj nowy pomiar</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Lokalizacja</th>
                <th>Data</th>
                <th>Temperatura</th>
                <th>Wilgotność</th>
                <th>Wiatr</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            {% for measurement in measurements %}
                <tr>
                    <td>{{ measurement.id }}</td>
                    <td>{{ measurement.location.city }} ({{ measurement.location.country }})</td>
                    <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
                    <td>{{ measurement.celsius }} °C</td>
                    <td>{{ measurement.humidity is not null ? measurement.humidity ~ '%' : '-' }}</td>
                    <td>{{ measurement.windSpeed is not null ? measurement.windSpeed ~ ' m/s' : '-' }}</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}" class="btn btn-sm btn-outline-primary">Edytuj</a>
                            <form method="post" action="{{ path('app_measurement_delete', {'id': measurement.id}) }}" onsubmit="return confirm('Czy na pewno chcesz usunąć ten rekord?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ measurement.id) }}">
                                <button class="btn btn-sm btn-outline-danger">Usuń</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center text-muted">Brak zapisanych pomiarów.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
